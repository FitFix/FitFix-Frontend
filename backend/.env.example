PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/fitfix?retryWrites=true&w=majority
# REQUIRED: private random value, 32+ chars. The server won't start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
# Optional: lets someone register as a gym owner by entering this token on the
# sign-up form. Leave empty to disable owner self-registration.
ADMIN_ACCESS_TOKEN=
# Optional, local development only: enables POST /api/auth/setup, which seeds
# demo accounts with a well-known password. Never enable on a real deployment.
ENABLE_DEMO_SETUP=false
